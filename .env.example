# Copia questo file in .env (non va in git) per lo sviluppo: npm run dev
# Elenco completo delle variabili nel README (Fase 6).

# vitabridge (Garmin) oppure heartbridge (Gima)
APP=vitabridge

# Dati in sola lettura: un file locale (sviluppo) oppure le copie da /admin/backup del server esistente
DATA_MODE=file
# npm run gen:synthetic crea data/synthetic-garmin.db e data/synthetic-gima.db
DATA_FILE=data/synthetic-garmin.db
# DATA_MODE=backup
# BACKUP_URL=https://server-dello-studio/admin/backup
# BACKUP_USERNAME=
# BACKUP_PASSWORD=
# BACKUP_DIR=backup/vitabridge
# BACKUP_INTERVAL_MIN=60
# SYNC_REFRESH_MIN_AGE_MIN=5

# Database degli account (scritto dal nostro server)
AUTH_DB=auth/vitabridge-auth.db

# Primo amministratore, creato all'avvio se non ne esiste nessuno (password di almeno 10 caratteri)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Indirizzo da cui si apre l'app: l'unica origine accettata per le richieste che modificano dati
PUBLIC_ORIGIN=http://localhost:5173
# Dietro un reverse proxy: l'IP per il limite ai tentativi di accesso si legge da X-Forwarded-For
TRUST_PROXY=false

# Ore distinte con battito perché un giorno conti nelle medie e nel confronto (1-24)
VALID_DAY_MIN_HOURS=12

# Scadenza delle sessioni per inattività
SESSION_IDLE_DAYS_PARTICIPANT=30
SESSION_IDLE_HOURS_ADMIN=8
