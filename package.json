{
  "name": "bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VitaBridge e HeartBridge: web app che mostrano ai partecipanti di uno studio i dati dei loro bracciali, letti in sola lettura dai server dello studio.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @bridge/web --",
    "build": "npm run build -w @bridge/web",
    "preview": "npm run preview -w @bridge/web --",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "gen:fit-profile": "python3 scripts/gen-fit-profile.py ../Gadgetbridge/FitCodeGenerator/src/main/resources/fit_profile.json > apps/web/src/lib/fit/profile.ts"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.16.0"
  }
}
