{
  "name": "bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VitaBridge e HeartBridge: web app che mostrano ai partecipanti di uno studio i dati dei loro dispositivi, letti in sola lettura dal server dello studio.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:heartbridge": "node scripts/dev.mjs --app heartbridge",
    "build": "npm run build -w @bridge/web && npm run build:heartbridge -w @bridge/web && npm run build -w @bridge/server",
    "preview": "npm run preview -w @bridge/web --",
    "preview:heartbridge": "npm run preview:heartbridge -w @bridge/web --",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "gen:fit-profile": "python3 scripts/gen-fit-profile.py ../Gadgetbridge/FitCodeGenerator/src/main/resources/fit_profile.json > packages/synth/src/fit/profile.ts",
    "gen:synthetic": "tsx packages/synth/src/cli.ts",
    "dev:web": "npm run dev -w @bridge/web --",
    "dev:server": "npm run dev -w @bridge/server",
    "admin:create": "tsx packages/server/src/admin-cli.ts create",
    "admin:reset-password": "tsx packages/server/src/admin-cli.ts reset-password",
    "admin:accept-source": "tsx packages/server/src/admin-cli.ts accept-source",
    "measure:compare": "tsx packages/server/src/comparison/measure.ts"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
