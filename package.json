{
  "name": "vitabridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web app open source che sostituisce Gadgetbridge per bracciali Garmin (vívosmart 5): Bluetooth, dati salvati in SQLite sul dispositivo.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "gen:fit-profile": "python3 scripts/gen-fit-profile.py ../Gadgetbridge/FitCodeGenerator/src/main/resources/fit_profile.json > src/lib/fit/profile.ts"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.50.4-build1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "radix-ui": "^1.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
