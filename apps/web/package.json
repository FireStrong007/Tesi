{
  "name": "@bridge/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web app di VitaBridge e HeartBridge: i dati di un partecipante allo studio, letti dal server dello studio e tenuti in una copia nel browser (SQLite su OPFS).",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:heartbridge": "tsc -b && vite build --mode heartbridge",
    "preview": "vite preview",
    "preview:heartbridge": "vite preview --mode heartbridge --outDir dist-heartbridge"
  },
  "dependencies": {
    "@bridge/core": "*",
    "@sqlite.org/sqlite-wasm": "^3.50.4-build1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "radix-ui": "^1.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.4"
  }
}
